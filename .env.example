# Database Configuration
POSTGRES_USER=adserver
POSTGRES_PASSWORD=adserver_secret
POSTGRES_DB=adserver_db
POSTGRES_PORT=5434

# Redis Configuration
REDIS_PORT=6381

# Application URLs (for running Go server on host)
DATABASE_URL=postgres://adserver:adserver_secret@localhost:5434/adserver_db?sslmode=disable
REDIS_URL=redis://localhost:6381/0

# Server Config
SERVER_PORT=8000
AD_FREQ_CAP_MAX=100
FREQUENCY_CAP_MAX=100
LOG_LEVEL=info

